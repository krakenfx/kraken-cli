# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Rust uses 4-space indentation (rustfmt default).
[*.rs]
indent_size = 4

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{md,mdx}]
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
